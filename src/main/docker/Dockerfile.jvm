
FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /workspace

COPY pom.xml .
COPY src ./src

RUN mvn package -DskipTests

FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.24

WORKDIR /deployments

COPY --from=build --chown=185 /workspace/target/quarkus-app/lib/ ./lib/
COPY --from=build --chown=185 /workspace/target/quarkus-app/*.jar ./
COPY --from=build --chown=185 /workspace/target/quarkus-app/app/ ./app/
COPY --from=build --chown=185 /workspace/target/quarkus-app/quarkus/ ./quarkus/

ENV PORT=8080
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Dquarkus.http.port=10000"

EXPOSE 8080

USER 185

ENTRYPOINT ["java", "-jar", "quarkus-run.jar"]
