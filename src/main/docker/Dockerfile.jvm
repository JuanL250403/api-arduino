# ---- Etapa 1: Compilación ----
FROM maven:3.9.6-eclipse-temurin-21 AS build
WORKDIR /code

# 1. Copiar el archivo POM primero para aprovechar la caché de capas de Docker
COPY pom.xml /code/

# 2. Copiar todo el código fuente del proyecto
COPY src /code/src

# 3. Compilar usando 'mvn' directamente en lugar del wrapper local
RUN mvn package -DskipTests

# ---- Etapa 2: Imagen de ejecución ligera ----
FROM eclipse-temurin:21-jre-jammy
WORKDIR /application

# Copiar los artefactos generados de Quarkus desde la etapa previa
COPY --from=build /code/target/quarkus-app/ /application/

EXPOSE 8080
ENV JAVA_OPTS="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"

CMD ["java", "-jar", "quarkus-run.jar"]
